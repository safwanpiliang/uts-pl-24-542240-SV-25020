# Salin berkas ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# File .env berisi kredensial asli dan TIDAK boleh di-commit.

# Kunci enkripsi Laravel. Buat dengan:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Basis data PostgreSQL (host-nya otomatis "db", nama service di docker-compose.yml)
DB_DATABASE=jadwalku
DB_USERNAME=jadwalku
DB_PASSWORD=

# Akun yang dibuat otomatis oleh seeder untuk login pertama
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=

# Port yang dibuka di host (opsional)
FRONTEND_PORT=8081
BACKEND_PORT=8000
